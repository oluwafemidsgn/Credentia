{
  "display_information": {
    "name": "Credentia Notifications",
    "description": "Posts resource downloads, checklist contributions and contact messages from credentia.site into Slack.",
    "background_color": "#351459"
  },
  "features": {
    "bot_user": {
      "display_name": "Credentia",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "incoming-webhook"
      ]
    }
  },
  "settings": {
    "incoming_webhooks": {
      "incoming_webhooks_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
